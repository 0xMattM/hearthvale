# Creditcoin / Attestcoin (local)

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
# GAME_TRUST_PROXY=1

# local_dev = SQLite REALM ledger / direct minter (playable without Sepolia ETH)
# attestcoin = Sepolia notary + RealmMinterASC via @gluwa/usc-sdk (hackathon path)
GAME_CREDITCOIN_MODE=attestcoin

CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/

# Fill after `npm run chain:deploy` then `chain:deploy:sepolia` + `chain:deploy:asc`
# See contracts/DEPLOY.md
# Use three different keys in a real deploy: CREDITCOIN_DEPLOY_KEY, SEPOLIA_RELAYER_KEY, CREDITCOIN_WORKER_KEY.
CREDITCOIN_REALM_TOKEN=
CREDITCOIN_LAND_NFT=
CREDITCOIN_MARKETPLACE=
CREDITCOIN_ASC=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_NOTARY=
SEPOLIA_RELAYER_KEY=
CREDITCOIN_DEPLOY_KEY=
CREDITCOIN_WORKER_KEY=
